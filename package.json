    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "parity": "node parity/run.mjs",
    "build": "./src/build-vfs.mjs",
    "build_fixture": "node -e \"const m = require('module').builtinModules; console.log(JSON.stringify([...m, ...m.filter(x => !x.startsWith('node:')).map(x => 'node:'+x)]))\" > ./lib/builtin-modules.json",
